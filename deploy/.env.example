WAVE_HTTP_PORT=8080
WAVE_DB_PASSWORD=wave
WAVE_MODEL_BASE_URL=https://api.openai.com/v1
WAVE_MODEL_API_KEY=
WAVE_MODEL_TIMEOUT_SEC=300
WAVE_WORKER_CONCURRENCY=10
WAVE_LEASE_SECONDS=30
WAVE_CONTEXT_TOKENS=32000
# Exact regexes, separated by actual newlines when multiple are required.
WAVE_GUARDRAIL_INPUT_BLOCK=
WAVE_GUARDRAIL_OUTPUT_REDACT=
WAVE_SANDBOX_BACKEND=sbx
WAVE_SBX_URL=http://host.docker.internal:6060
WAVE_SBX_TOKEN=
WAVE_SBX_IMAGE=docker.io/docker/sandbox-ubuntu-24.04:latest
WAVE_SBX_CPUS=2
WAVE_SBX_MEMORY_MIB=2048
# Local runs commands with the service user's host permissions: development only.
WAVE_SANDBOX_ALLOW_LOCAL=false
# MCP egress defaults to refusing private and link-local destinations.
WAVE_EGRESS_ALLOW_PRIVATE=false
# make setup generates this once. Back up this file; all replicas share the key.
WAVE_MASTER_KEY=

# SeaweedFS is the default; it creates the private bucket on startup.
WAVE_STORAGE_BACKEND=s3
WAVE_S3_BUCKET=wave
WAVE_S3_REGION=us-east-1
# Compose service address. For AWS S3, explicitly leave the value empty.
WAVE_S3_ENDPOINT=http://seaweedfs:8333
WAVE_S3_PREFIX=wave
WAVE_S3_PATH_STYLE=true
# HTTP stays inside the Docker network; remote endpoints should use TLS.
WAVE_S3_ALLOW_HTTP=true
# make setup generates private SeaweedFS credentials once, never sent to sandboxes.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
